# ── PostgreSQL (Supabase now → Azure later) ────────────────────────────────
# Copy this file to `.env.local` and fill in real values. `.env.local` is gitignored.

# Runtime queries — Supabase TRANSACTION POOLER (port 6543).
# Supabase dashboard → Project Settings → Database → Connection string → "Transaction pooler".
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Migrations — DIRECT connection (port 5432).
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# ── Migrating to Azure later ────────────────────────────────────────────────
# Swap BOTH URLs for the Azure Database for PostgreSQL connection string,
# e.g. postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/postgres?sslmode=require
# No application code changes required.

# ── Admin authentication ────────────────────────────────────────────────────
# Secret used to sign the admin session cookie. Generate a strong one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Demo fallback admin, used ONLY when no admin exists in the database.
# With a database connected, real admins live in the `users` table (role='admin').
ADMIN_EMAIL="admin@anchorfitness.com"
ADMIN_PASSWORD="anchor-admin"

# ── Student login (Google OAuth) ────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). Authorized redirect URI must be:
#   <your-origin>/api/auth/callback/google
# e.g. http://localhost:3000/api/auth/callback/google (dev)
#      https://<your-domain>/api/auth/callback/google (prod)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Payments ────────────────────────────────────────────────────────────────
# The site's public address, used for Google login, Stripe return URLs, the
# Swish callback, admin redirects and links in emails. SET THIS IN PRODUCTION —
# behind Azure Static Web Apps the app otherwise sees an internal localhost:8080.
# e.g. SITE_URL="https://red-stone-076817910.7.azurestaticapps.net"
# Leave blank in dev (the request's own origin is used).
SITE_URL=""
NEXT_PUBLIC_SITE_URL=""                  # older name, still honoured

# Stripe — card payments run on Stripe's hosted Checkout page, so no card
# details are ever entered on this site. Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=""
STRIPE_CURRENCY="sek"

# Swish Handel — the merchant number and the certificate issued by the bank.
# Same merchant account as the RhythmBlaze workshop site.
SWISH_PAYEE_ALIAS=""
SWISH_ENV="production"                  # "production" | "test"
# Recommended: upload the certificate in Admin → Portal Settings → Swish
# Certificate (stored encrypted, see SECRETS_ENCRYPTION_KEY). An uploaded
# certificate takes priority. These three are only a fallback — file paths on
# the server, or the PEM text pasted in. Never commit the certificate.
SWISH_CERT_PATH=""
SWISH_KEY_PATH=""
SWISH_KEY_PASS=""

# Encrypts secrets uploaded in the admin panel (the Swish certificate + key)
# before they're stored in the database. REQUIRED in production. Generate once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it stable and identical on every server sharing the database — a
# different value can't decrypt certificates that were already uploaded.
SECRETS_ENCRYPTION_KEY=""
# Swish must be able to reach this over public HTTPS. Unreachable in local dev —
# the pay screen polls Swish directly, so payments still confirm without it.
SWISH_CALLBACK_URL=""
# Safety valve for testing against a LIVE merchant number: charge this amount
# (SEK) instead of the real total. Leave empty in production.
SWISH_DEMO_AMOUNT=""

# ── Email (Postmark) ────────────────────────────────────────────────────────
# Welcome + booking confirmation emails. The wording is edited in
# Admin → Email Templates. Without a token, emails are only logged (dev).
POSTMARK_SERVER_TOKEN=""
# Must be a verified Sender Signature / domain in Postmark.
EMAIL_FROM="Anchor Dance & Fitness <noreply@anchorcricket.com>"
EMAIL_REPLY_TO=""                        # optional
# Fallback recipients for the "new booking" admin email (comma-separated);
# normally set in Admin → Email Templates → New booking (to admin).
EMAIL_ADMIN_TO=""

# ── Optional: only if you later adopt the Supabase JS client / Auth ─────────
# NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
