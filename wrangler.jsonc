{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anchor-dance-fitness",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  // nodejs_compat is required: this app uses node:crypto, node:zlib (Excel and
  // PDF generation), bcryptjs and the postgres driver.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "anchor-dance-fitness"
    }
  ],
  // The database. Hyperdrive pools the connections and keeps them warm, which
  // matters because the database is in Sydney and a cold handshake costs
  // seconds. Connects as `hyperdrive_user` — read/write on the data, no DDL;
  // migrations still run as `postgres` through DIRECT_URL.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "386259b84aba42e5b1d06c1361f333f9",
      // Only ever used when the bindings are emulated locally — `wrangler
      // deploy` builds that emulated env before it uploads, and refuses to
      // start without this. It is never connected to in production, so it is
      // deliberately a placeholder and holds no real credentials.
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/postgres"
    }
  ]
  // Swish presents the merchant certificate through this binding, because a
  // Worker cannot attach one to an outbound request itself. Upload it once:
  //   wrangler mtls-certificate upload --cert swish_cert.pem --key swish.key --name swish
  // then put the id it prints here and redeploy. Until that exists, Swish
  // payments are refused with a clear message rather than failing silently.
  // "mtls_certificates": [{ "binding": "SWISH_CERT", "certificate_id": "<id>" }],
  // Payment reminders + waitlist sweep (replaces the external cron caller):
  // "triggers": { "crons": ["0 * * * *"] }
}
